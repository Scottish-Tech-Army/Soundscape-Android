<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ replacement for android:fullBackupContent, covering cloud backups and
   device-to-device transfers. Mirrors backup_rules.xml, which still applies pre-12.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
