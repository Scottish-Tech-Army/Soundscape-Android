/* Spoken Siri commands - French.

   Values only: the keys are the English phrases declared in
   SoundscapeAppShortcuts.swift and must stay exactly as they are. See
   en.lproj/AppShortcuts.strings for the rules (${applicationName} in every phrase, ${parameter}
   tokens kept but free to move).

   Every phrase keeps the shape "<app name> <group> <choice>", so knowing the six
   group words is enough to reach everything.

   First pass, not authored by a native speaker - corrections welcome. */

"${applicationName} surroundings ${kind}" = "${applicationName} environs ${kind}";
"${applicationName} surroundings" = "${applicationName} environs";

"${applicationName} route ${command}" = "${applicationName} itinéraire ${command}";
"${applicationName} route" = "${applicationName} itinéraire";

"${applicationName} start route ${route}" = "${applicationName} démarre l'itinéraire ${route}";
"${applicationName} start route" = "${applicationName} démarre l'itinéraire";

"${applicationName} beacon ${marker}" = "${applicationName} balise ${marker}";
"${applicationName} beacon" = "${applicationName} balise";

"${applicationName} list ${kind}" = "${applicationName} liste ${kind}";
"${applicationName} list" = "${applicationName} liste";

"${applicationName} stop beacon" = "${applicationName} arrête la balise";
