/* Spoken Siri commands - Finnish.

   Values only: the keys are the English phrases declared in
   SoundscapeAppShortcuts.swift and must stay exactly as they are. See
   en.lproj/AppShortcuts.strings for the rules (${applicationName} in every phrase, ${parameter}
   tokens kept but free to move).

   Every phrase keeps the shape "<app name> <group> <choice>", so knowing the six
   group words is enough to reach everything.

   First pass, not authored by a native speaker - corrections welcome. */

"${applicationName} surroundings ${kind}" = "${applicationName} ympäristö ${kind}";
"${applicationName} surroundings" = "${applicationName} ympäristö";

"${applicationName} route ${command}" = "${applicationName} reitti ${command}";
"${applicationName} route" = "${applicationName} reitti";

"${applicationName} start route ${route}" = "${applicationName} aloita reitti ${route}";
"${applicationName} start route" = "${applicationName} aloita reitti";

"${applicationName} beacon ${marker}" = "${applicationName} majakka ${marker}";
"${applicationName} beacon" = "${applicationName} majakka";

"${applicationName} list ${kind}" = "${applicationName} luettelo ${kind}";
"${applicationName} list" = "${applicationName} luettelo";

"${applicationName} stop beacon" = "${applicationName} pysäytä majakka";
