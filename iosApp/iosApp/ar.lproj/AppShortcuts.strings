/* Spoken Siri commands - Arabic.

   Values only: the keys are the English phrases declared in
   SoundscapeAppShortcuts.swift and must stay exactly as they are. See
   en.lproj/AppShortcuts.strings for the rules (${applicationName} in every phrase, ${parameter}
   tokens kept but free to move).

   Every phrase keeps the shape "<app name> <group> <choice>", so knowing the six
   group words is enough to reach everything.

   First pass, not authored by a native speaker - corrections welcome. */

"${applicationName} surroundings ${kind}" = "${applicationName} المحيط ${kind}";
"${applicationName} surroundings" = "${applicationName} المحيط";

"${applicationName} route ${command}" = "${applicationName} المسار ${command}";
"${applicationName} route" = "${applicationName} المسار";

"${applicationName} start route ${route}" = "${applicationName} ابدأ المسار ${route}";
"${applicationName} start route" = "${applicationName} ابدأ المسار";

"${applicationName} beacon ${marker}" = "${applicationName} المنارة ${marker}";
"${applicationName} beacon" = "${applicationName} المنارة";

"${applicationName} list ${kind}" = "${applicationName} قائمة ${kind}";
"${applicationName} list" = "${applicationName} قائمة";

"${applicationName} stop beacon" = "${applicationName} أوقف المنارة";
