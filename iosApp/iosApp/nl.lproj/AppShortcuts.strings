/* Spoken Siri commands - Dutch.

   Values only: the keys are the English phrases declared in
   SoundscapeAppShortcuts.swift and must stay exactly as they are. See
   en.lproj/AppShortcuts.strings for the rules (${applicationName} in every phrase, ${parameter}
   tokens kept but free to move).

   Every phrase keeps the shape "<app name> <group> <choice>", so knowing the six
   group words is enough to reach everything.

   First pass, not authored by a native speaker - corrections welcome. */

"${applicationName} surroundings ${kind}" = "${applicationName} omgeving ${kind}";
"${applicationName} surroundings" = "${applicationName} omgeving";

"${applicationName} route ${command}" = "${applicationName} route ${command}";
"${applicationName} route" = "${applicationName} route";

"${applicationName} start route ${route}" = "${applicationName} start route ${route}";
"${applicationName} start route" = "${applicationName} start route";

"${applicationName} beacon ${marker}" = "${applicationName} baken ${marker}";
"${applicationName} beacon" = "${applicationName} baken";

"${applicationName} list ${kind}" = "${applicationName} lijst ${kind}";
"${applicationName} list" = "${applicationName} lijst";

"${applicationName} stop beacon" = "${applicationName} stop baken";
