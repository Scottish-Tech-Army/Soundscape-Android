/* Spoken Siri commands - Russian.

   Values only: the keys are the English phrases declared in
   SoundscapeAppShortcuts.swift and must stay exactly as they are. See
   en.lproj/AppShortcuts.strings for the rules (${applicationName} in every phrase, ${parameter}
   tokens kept but free to move).

   Every phrase keeps the shape "<app name> <group> <choice>", so knowing the six
   group words is enough to reach everything.

   First pass, not authored by a native speaker - corrections welcome. */

"${applicationName} surroundings ${kind}" = "${applicationName} окружение ${kind}";
"${applicationName} surroundings" = "${applicationName} окружение";

"${applicationName} route ${command}" = "${applicationName} маршрут ${command}";
"${applicationName} route" = "${applicationName} маршрут";

"${applicationName} start route ${route}" = "${applicationName} запусти маршрут ${route}";
"${applicationName} start route" = "${applicationName} запусти маршрут";

"${applicationName} beacon ${marker}" = "${applicationName} маяк ${marker}";
"${applicationName} beacon" = "${applicationName} маяк";

"${applicationName} list ${kind}" = "${applicationName} список ${kind}";
"${applicationName} list" = "${applicationName} список";

"${applicationName} stop beacon" = "${applicationName} выключи маяк";
