    "You can say: Soundscape surroundings, Soundscape route, Soundscape start route, Soundscape beacon, Soundscape stop beacon, Soundscape detail, or Soundscape list.": {
      "comment": "Recites the spoken phrases. Translate only alongside that language's phrases in <locale>.lproj/AppShortcuts.strings.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك أن تقول: Soundscape المحيط، Soundscape المسار، Soundscape ابدأ المسار، Soundscape المنارة، Soundscape أوقف المنارة، Soundscape التفاصيل، أو Soundscape قائمة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan sige: Soundscape omgivelser, Soundscape rute, Soundscape start rute, Soundscape lydfyr, Soundscape stop lydfyr, Soundscape detaljer eller Soundscape liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können sagen: Soundscape Umgebung, Soundscape Route, Soundscape starte Route, Soundscape Beacon, Soundscape stoppe Beacon, Soundscape Details oder Soundscape Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes decir: Soundscape entorno, Soundscape ruta, Soundscape iniciar ruta, Soundscape señal, Soundscape detener señal, Soundscape detalle o Soundscape lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit sanoa: Soundscape ympäristö, Soundscape reitti, Soundscape aloita reitti, Soundscape majakka, Soundscape pysäytä majakka, Soundscape yksityiskohdat tai Soundscape luettelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez dire : Soundscape environs, Soundscape itinéraire, Soundscape démarre l'itinéraire, Soundscape balise, Soundscape arrête la balise, Soundscape détails ou Soundscape liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi dire: Soundscape dintorni, Soundscape percorso, Soundscape avvia percorso, Soundscape audiofaro, Soundscape ferma audiofaro, Soundscape dettagli o Soundscape elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Soundscape 周辺」「Soundscape ルート」「Soundscape ルート開始」「Soundscape ビーコン」「Soundscape ビーコン停止」「Soundscape 詳細」「Soundscape リスト」と言えます。"
          }
        },
        "ko": {
          "stringUnit": {
