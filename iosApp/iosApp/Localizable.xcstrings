    "Sets an audio beacon on one of your saved markers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط منارة صوتية على إحدى علاماتك المحفوظة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задава аудио маяк на някой от запазените Ви маркери."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কোনো একটি সংরক্ষিত মার্কারে অডিও বীকন বসায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa una balisa sonora en un dels teus marcadors desats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví zvukový maják na některou z vašich uložených značek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætter et lydfyr på et af dine gemte mærker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt ein Audiobeacon auf eine Ihrer gespeicherten Markierungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίζει ένα ηχητικό σήμα σε έναν από τους αποθηκευμένους δείκτες σας."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets an audio beacon on one of your saved markers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone una señal de audio en uno de tus marcadores guardados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seab helimajaka ühele sinu salvestatud markeritest."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی یکی از نشانه‌های ذخیره‌شده‌تان جهت‌نمای صوتی تنظیم می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa äänimajakan johonkin tallennetuista merkinnöistäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place une balise sonore sur l’un de vos marqueurs enregistrés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Place une balise audio sur l’un de vos marqueurs enregistrés."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana saita siginar sauti a kan ɗaya daga cikin alamominka da aka ajiye."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके किसी सहेजे गए मार्कर पर ऑडियो बीकन लगाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavlja zvučni svjetionik na jednu od vaših spremljenih oznaka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangjelzőt állít be valamelyik mentett jelölőjén."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasang suar audio pada salah satu penanda tersimpan Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Setur hljóðvita á eitt af vistuðu merkjunum þínum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un audiofaro su uno dei tuoi indicatori salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したマーカーのひとつに音声ビーコンを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 마커 중 하나에 오디오 비콘을 설정합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या एखाद्या जतन केलेल्या मार्करवर ऑडिओ बीकन ठेवते."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter et lydsignal på en av de lagrede markørene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt een audiobaken in op een van uw opgeslagen markeringen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia dźwięk naprowadzający na jednym z twoich zapisanych znaczników."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca um sinal de áudio num dos seus marcos guardados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca um sinalizador sonoro em um dos seus favoritos salvos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune o baliză audio pe unul dintre marcajele tale salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает звуковой маяк на одну из ваших сохранённых отметок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví zvukový maják na niektorú z vašich uložených značiek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavi zvočni svetilnik na eno od vaših shranjenih oznak."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставља звучни бакен на један од ваших сачуваних маркера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställer in ett ljudfyr på en av dina sparade platsmarkörer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaweka beacon ya sauti kwenye mojawapo ya alama zako zilizohifadhiwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சேமித்த குறிப்பான்களில் ஒன்றில் ஒலி பீக்கனை அமைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సేవ్ చేసిన మార్కర్‌లలో ఒకదానిపై ఆడియో బీకాన్‌ను సెట్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งบีคอนเสียงไว้ที่หมุดที่บันทึกไว้หมุดใดหมุดหนึ่งของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı noktalarınızdan birine sesli işaret koyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлює звуковий маячок на одну з ваших збережених міток."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کسی محفوظ مارکر پر آڈیو بیکن سیٹ کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt đèn hiệu âm thanh lên một trong các điểm đánh dấu đã lưu của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你已保存的某个标记点上设置音频信标。"
          }
        }
      }
    },
    "Sets how much Soundscape says as you walk.": {
      "localizations": {}
    },
    "Silent": {
      "localizations": {}
    },
    "Skips waypoints, mutes the beacon, or stops the route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتخطى نقاط المسار، أو يكتم المنارة، أو يوقف المسار."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прескача пътни точки, изключва звука на маяка или спира маршрута."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়েপয়েন্ট এড়িয়ে যায়, বীকন মিউট করে, বা রুট বন্ধ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta punts de ruta, silencia la balisa o atura la ruta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přeskakuje trasové body, ztlumí maják nebo zastaví trasu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Springer vejpunkter over, slår lydfyret fra eller stopper ruten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringt Wegpunkte, schaltet das Beacon stumm oder beendet die Route."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακάμπτει σημεία πορείας, θέτει σε σίγαση το ηχητικό σήμα ή διακόπτει τη διαδρομή."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips waypoints, mutes the beacon, or stops the route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta puntos de ruta, silencia la señal o detiene la ruta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätab teekonnapunkte vahele, summutab majaka või peatab marsruudi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از نقطه‌های بین‌راهی رد می‌شود، صدای جهت‌نما را می‌بندد، یا مسیر را متوقف می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohittaa reittipisteitä, hiljentää majakan tai pysäyttää reitin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe des points de repère, coupe le son de la balise ou arrête l’itinéraire."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe des points de cheminement, coupe le son de la balise ou arrête l’itinéraire."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana tsallake matsayai, ya kashe siginar sauti, ko ya tsayar da tafarkin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मार्ग बिंदु छोड़ता है, बीकन म्यूट करता है, या मार्ग रोक देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preskače putne točke, utišava svjetionik ili zaustavlja rutu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Útvonalpontokat ugrik át, elnémítja a hangjelzőt, vagy leállítja az útvonalat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melewati titik rute, menonaktifkan suara suar, atau menghentikan rute."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleppir leiðarpunktum, slekkur á hljóðvitanum eða stöðvar leiðina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta i waypoint, disattiva l’audio dell’audiofaro o interrompe il percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェイポイントをスキップし、ビーコンをミュートし、またはルートを停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경유지를 건너뛰거나, 비콘을 음소거하거나, 경로를 중지합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मार्ग बिंदू वगळते, बीकन म्यूट करते, किंवा मार्ग थांबवते."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hopper over veipunkter, slår av lydsignalet eller stopper ruten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat routepunten over, dempt het baken of stopt de route."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomija punkty trasy, wycisza dźwięk naprowadzający albo zatrzymuje trasę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta Pontos de Passagem, desativa o som do sinal ou para a rota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pula localizadores, ativa o mudo do sinalizador ou interrompe a rota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sare peste puncte de traseu, dezactivează sunetul balizei sau oprește ruta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропускает путевые точки, отключает маяк или останавливает маршрут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preskakuje body trasy, stlmí maják alebo zastaví trasu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preskoči točke poti, utiša svetilnik ali zaustavi pot."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Прескаче путне тачке, утишава бакен или зауставља руту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoppar över brytpunkter, stänger av ljudfyret eller stoppar rutten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaruka vituo, inazima sauti ya beacon, au inasimamisha njia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழிப்புள்ளிகளைத் தவிர்க்கும், பீக்கனை முடக்கும், அல்லது பாதையை நிறுத்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేపాయింట్‌లను దాటవేస్తుంది, బీకాన్‌ను మ్యూట్ చేస్తుంది, లేదా రూట్‌ను ఆపివేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้ามจุดผ่านทาง ปิดเสียงบีคอน หรือหยุดเส้นทาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara noktaları atlar, işareti sessize alır ya da rotayı durdurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропускає зупинки, вимикає звук маячка або зупиняє маршрут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویپوائنٹس چھوڑ دیتا ہے، بیکن خاموش کرتا ہے، یا روٹ روک دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ qua điểm dừng, tắt tiếng đèn hiệu, hoặc dừng lộ trình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过航点、静音信标，或停止路线。"
          }
        }
      }
    },
