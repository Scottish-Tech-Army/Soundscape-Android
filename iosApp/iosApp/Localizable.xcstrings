    "Describes where you are and what is around you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصف مكانك وما يحيط بك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Описва къде се намирате и какво има около Вас."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কোথায় আছেন এবং আপনার চারপাশে কী আছে তা বর্ণনা করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descriu on ets i què tens al voltant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popíše, kde jste a co je kolem vás."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriver, hvor du er, og hvad der er omkring dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibt, wo Sie sind und was sich um Sie herum befindet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιγράφει πού βρίσκεστε και τι υπάρχει γύρω σας."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Describes where you are and what is around you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe dónde estás y qué hay a tu alrededor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjeldab, kus sa oled ja mis on sinu ümber."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توصیف می‌کند کجا هستید و چه چیزی اطرافتان است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvailee, missä olet ja mitä ympärilläsi on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrit où vous êtes et ce qui vous entoure."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrit où vous êtes et ce qui vous entoure."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana bayyana inda kake da abin da ke kewaye da kai."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताता है कि आप कहाँ हैं और आपके आसपास क्या है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisuje gdje ste i što je oko vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leírja, hol van, és mi van Ön körül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjelaskan di mana Anda berada dan apa yang ada di sekitar Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lýsir hvar þú ert og hvað er í kringum þig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrive dove sei e che cosa hai intorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地と周囲の様子を説明します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치와 주변에 무엇이 있는지 설명합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही कुठे आहात आणि तुमच्याभोवती काय आहे ते सांगते."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriver hvor du er og hva som er rundt deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijft waar u bent en wat er om u heen is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisuje, gdzie jesteś i co masz wokół siebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreve onde está e o que tem à sua volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreve onde você está e o que há ao seu redor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrie unde te afli și ce este în jurul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Описывает, где вы находитесь и что вокруг вас."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opíše, kde ste a čo je okolo vás."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opiše, kje ste in kaj je okoli vas."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Описује где сте и шта је око вас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriver var du är och vad som finns omkring dig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaeleza ulipo na kilichopo karibu nawe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எங்கே இருக்கிறீர்கள், உங்களைச் சுற்றி என்ன உள்ளது என்பதை விவரிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎక్కడ ఉన్నారో, మీ చుట్టూ ఏముందో వివరిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกว่าคุณอยู่ที่ไหนและมีอะไรอยู่รอบตัวคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerede olduğunuzu ve çevrenizde ne olduğunu anlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Описує, де ви є і що навколо вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بتاتا ہے کہ آپ کہاں ہیں اور آپ کے اردگرد کیا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
