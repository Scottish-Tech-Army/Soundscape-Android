    "Reads back your saved routes, your saved markers, or the commands you can say.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ مساراتك المحفوظة أو علاماتك المحفوظة أو الأوامر التي يمكنك قولها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочита запазените Ви маршрути, запазените Ви маркери или командите, които можете да кажете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সংরক্ষিত রুট, সংরক্ষিত মার্কার, বা আপনি যেসব কমান্ড বলতে পারেন তা পড়ে শোনায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegeix les teves rutes desades, els teus marcadors desats o les ordres que pots dir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přečte vaše uložené trasy, vaše uložené značky nebo příkazy, které můžete říct."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læser dine gemte ruter, dine gemte mærker eller de kommandoer, du kan sige, op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest Ihre gespeicherten Routen, Ihre gespeicherten Markierungen oder die Befehle vor, die Sie sagen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζει τις αποθηκευμένες διαδρομές σας, τους αποθηκευμένους δείκτες σας ή τις εντολές που μπορείτε να πείτε."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads back your saved routes, your saved markers, or the commands you can say."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee tus rutas guardadas, tus marcadores guardados o los comandos que puedes decir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loeb ette sinu salvestatud marsruudid, salvestatud markerid või käsklused, mida saad öelda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسیرهای ذخیره‌شده، نشانه‌های ذخیره‌شده، یا فرمان‌هایی که می‌توانید بگویید را می‌خواند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukee tallennetut reittisi, tallennetut merkintäsi tai komennot, jotka voit sanoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relit vos itinéraires enregistrés, vos marqueurs enregistrés ou les commandes que vous pouvez dire."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Relit vos itinéraires enregistrés, vos marqueurs enregistrés ou les commandes que vous pouvez dire."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana karanta tafarkunka da aka ajiye, alamominka da aka ajiye, ko umarnan da za ka iya faɗa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सहेजे गए मार्ग, सहेजे गए मार्कर, या वे आदेश पढ़कर सुनाता है जो आप कह सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čita vaše spremljene rute, vaše spremljene oznake ili naredbe koje možete izgovoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felolvassa a mentett útvonalait, a mentett jelölőit vagy a kimondható parancsokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membacakan rute tersimpan Anda, penanda tersimpan Anda, atau perintah yang bisa Anda ucapkan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Les upp vistuðu leiðirnar þínar, vistuðu merkin þín eða skipanirnar sem þú getur sagt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilegge i tuoi percorsi salvati, i tuoi indicatori salvati o i comandi che puoi dire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したルート、保存したマーカー、または使えるコマンドを読み上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 경로, 저장한 마커 또는 말할 수 있는 명령을 읽어 줍니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे जतन केलेले मार्ग, जतन केलेले मार्कर, किंवा तुम्ही म्हणू शकता ते आदेश वाचून दाखवते."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leser opp de lagrede rutene dine, de lagrede markørene dine eller kommandoene du kan si."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest uw opgeslagen routes, uw opgeslagen markeringen of de opdrachten die u kunt zeggen voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje twoje zapisane trasy, twoje zapisane znaczniki albo polecenia, które możesz wypowiedzieć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as suas rotas guardadas, os seus marcos guardados ou os comandos que pode dizer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê suas rotas salvas, seus favoritos salvos ou os comandos que você pode dizer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți citește rutele salvate, marcajele salvate sau comenzile pe care le poți spune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачитывает ваши сохранённые маршруты, ваши сохранённые отметки или команды, которые можно произнести."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prečíta vaše uložené trasy, vaše uložené značky alebo príkazy, ktoré môžete povedať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebere vaše shranjene poti, vaše shranjene oznake ali ukaze, ki jih lahko izgovorite."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Чита ваше сачуване руте, ваше сачуване маркере или команде које можете изговорити."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser upp dina sparade rutter, dina sparade platsmarkörer eller de kommandon du kan säga."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inasoma njia zako zilizohifadhiwa, alama zako zilizohifadhiwa, au amri unazoweza kusema."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சேமித்த பாதைகள், சேமித்த குறிப்பான்கள், அல்லது நீங்கள் சொல்லக்கூடிய கட்டளைகளை வாசிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సేవ్ చేసిన రూట్‌లు, సేవ్ చేసిన మార్కర్‌లు, లేదా మీరు చెప్పగల కమాండ్‌లను చదివి వినిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเส้นทางที่บันทึกไว้ หมุดที่บันทึกไว้ หรือคำสั่งที่คุณพูดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı rotalarınızı, kayıtlı noktalarınızı ya da söyleyebileceğiniz komutları okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачитує ваші збережені маршрути, ваші збережені мітки або команди, які ви можете сказати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے محفوظ روٹس، محفوظ مارکرز، یا وہ کمانڈز پڑھ کر سناتا ہے جو آپ کہہ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc lại các lộ trình đã lưu, các điểm đánh dấu đã lưu, hoặc những lệnh bạn có thể nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读出你已保存的路线、已保存的标记点，或你可以说的命令。"
          }
        }
      }
    },
