/* Spoken Siri commands - Japanese.

   Values only: the keys are the English phrases declared in
   SoundscapeAppShortcuts.swift and must stay exactly as they are. See
   en.lproj/AppShortcuts.strings for the rules (${applicationName} in every phrase, ${parameter}
   tokens kept but free to move).

   Every phrase keeps the shape "<app name> <group> <choice>", so knowing the six
   group words is enough to reach everything.

   First pass, not authored by a native speaker - corrections welcome. */

"${applicationName} surroundings ${kind}" = "${applicationName} 周辺 ${kind}";
"${applicationName} surroundings" = "${applicationName} 周辺";

"${applicationName} route ${command}" = "${applicationName} ルート ${command}";
"${applicationName} route" = "${applicationName} ルート";

"${applicationName} start route ${route}" = "${applicationName} ルート開始 ${route}";
"${applicationName} start route" = "${applicationName} ルート開始";

"${applicationName} beacon ${marker}" = "${applicationName} ビーコン ${marker}";
"${applicationName} beacon" = "${applicationName} ビーコン";

"${applicationName} list ${kind}" = "${applicationName} リスト ${kind}";
"${applicationName} list" = "${applicationName} リスト";

"${applicationName} stop beacon" = "${applicationName} ビーコン停止";
