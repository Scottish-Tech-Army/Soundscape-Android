            "value": "Soundscape нужно ваше местоположение, чтобы обеспечивать аудионавигацию и описывать ваше окружение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape potrebuje vašu polohu, aby mohol poskytovať zvukovú navigáciu a opisovať vaše okolie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape potrebuje vašo lokacijo, da lahko zagotavlja zvočno navigacijo in opisuje vašo okolico."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape-у је потребна ваша локација да би пружао звучну навигацију и описивао вашу околину."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape behöver din plats för att kunna ge ljudnavigering och beskriva dina omgivningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape inahitaji mahali ulipo ili kutoa maelekezo ya sauti na kueleza mazingira yanayokuzunguka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆடியோ வழிசெலுத்தலை வழங்கவும் உங்கள் சுற்றுப்புறத்தை விவரிக்கவும் Soundscape க்கு உங்கள் இருப்பிடம் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆడియో నావిగేషన్ అందించడానికి మరియు మీ పరిసరాలను వివరించడానికి Soundscapeకు మీ లొకేషన్ అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape ต้องการตำแหน่งที่ตั้งของคุณเพื่อให้บริการนำทางด้วยเสียงและอธิบายสภาพแวดล้อมรอบตัวคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape, sesli gezinme sağlamak ve çevrenizi betimlemek için konumunuza ihtiyaç duyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape потрібне ваше місцезнаходження, щоб надавати аудіонавігацію та описувати ваше оточення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape کو آڈیو نیویگیشن فراہم کرنے اور آپ کے ارد گرد کے ماحول کی تفصیل بتانے کے لیے آپ کے مقام کی ضرورت ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape cần vị trí của bạn để cung cấp điều hướng bằng âm thanh và mô tả không gian xung quanh bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape 需要您的位置信息，以便提供音频导航并描述您周围的环境。"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Soundscape بيانات الحركة لتحديد الاتجاه الذي تواجهه وتوجيه النداءات الصوتية نحو ما يحيط بك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape използва данни за движение, за да определи посоката, в която сте обърнати, и да насочи аудио съобщенията спрямо околността Ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কোন দিকে মুখ করে আছেন তা শনাক্ত করতে এবং ঘোষণাগুলো আপনার চারপাশের পরিবেশ অনুযায়ী সাজাতে Soundscape গতিবিধি ডেটা ব্যবহার করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape utilitza dades de moviment per detectar cap a on estàs orientat i orientar els avisos de veu respecte al teu entorn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape používá pohybová data k rozpoznání směru, kterým jste otočeni, a k nasměrování zvukových hlášení podle vašeho okolí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape bruger bevægelsesdata til at registrere, hvilken retning du vender, og til at placere lydbeskederne i forhold til dine omgivelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape verwendet Bewegungsdaten, um Ihre Blickrichtung zu erkennen und Audio-Hinweise an Ihrer Umgebung auszurichten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Soundscape χρησιμοποιεί δεδομένα κίνησης για να εντοπίζει την κατεύθυνση προς την οποία κοιτάτε και να προσανατολίζει τις ηχητικές επεξηγήσεις ως προς το περιβάλλον σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape uses motion data to detect the direction you are facing and orient audio callouts to your surroundings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape uses motion data to detect the direction you are facing and orient audio callouts to your surroundings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape usa datos de movimiento para detectar la dirección hacia la que mira y orientar los avisos de audio respecto a su entorno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape kasutab liikumisandmeid, et tuvastada suund, kuhu te näoga olete, ja suunata häälteated vastavalt teie ümbrusele."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساند‌اسکیپ از داده‌های حرکتی استفاده می‌کند تا جهتی را که رو به آن ایستاده‌اید تشخیص دهد و اعلان‌های صوتی را نسبت به محیط پیرامون شما جهت‌دهی کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape käyttää liikedataa tunnistaakseen, mihin suuntaan olet kääntyneenä, ja suunnatakseen ääni-ilmoitukset ympäristöösi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape utilise les données de mouvement pour détecter la direction dans laquelle vous êtes tourné et orienter les notifications audio par rapport à votre environnement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape utilise les données de mouvement pour détecter la direction dans laquelle vous êtes tourné et orienter les annonces audio par rapport à votre environnement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape tana amfani da bayanan motsi domin gane inda kuke fuskanta da kuma daidaita sanarwowin sauti da abin da ke kewaye da ku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape मोशन डेटा का उपयोग करके यह पता लगाता है कि आपका मुख किस दिशा में है और कॉलआउट को आपके परिवेश के अनुसार दिशा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape koristi podatke o pokretu kako bi otkrio smjer u kojem ste okrenuti i uskladio zvučne najave s vašom okolinom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Soundscape mozgásadatokat használ, hogy megállapítsa, merre néz, és a hangos bejelentéseket a környezetéhez igazítsa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape menggunakan data gerakan untuk mendeteksi arah hadap Anda dan menyesuaikan pemberitahuan audio dengan lingkungan sekitar Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape notar hreyfigögn til að greina í hvaða átt þú snýrð og staðsetja hljóðtilkynningar miðað við umhverfi þitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape utilizza i dati di movimento per rilevare la direzione verso cui sei rivolto e orientare le notifiche audio rispetto ai tuoi dintorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape は、あなたが向いている方向を検出し、コールアウトを周囲に合わせて定位するためにモーションデータを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape는 동작 데이터를 사용하여 사용자가 향하는 방향을 감지하고 오디오 안내를 주변 환경에 맞춰 배치합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे तोंड कोणत्या दिशेला आहे हे ओळखण्यासाठी आणि ध्वनी सूचना तुमच्या परिसरानुसार दिशाबद्ध करण्यासाठी Soundscape गती डेटा वापरते."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape bruker bevegelsesdata for å registrere hvilken retning du står mot, og plassere lydmeldingene i forhold til omgivelsene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape gebruikt bewegingsgegevens om te bepalen welke richting u op kijkt en om de audio-aankondigingen op uw omgeving af te stemmen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape wykorzystuje dane ruchu, aby wykryć kierunek, w którym jesteś zwrócony, i dopasować powiadomienia głosowe do Twojego otoczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Soundscape utiliza dados de movimento para detetar a direção para a qual está virado e orientar os avisos de áudio em relação às suas imediações."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Soundscape usa dados de movimento para detectar a direção para a qual você está voltado e orientar as notificações de áudio em relação aos seus arredores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape folosește date de mișcare pentru a detecta direcția în care ești orientat și pentru a orienta anunțurile audio în raport cu împrejurimile tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape использует данные движения, чтобы определять направление, в котором вы повёрнуты, и располагать звуковые уточнения относительно вашего окружения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape používa pohybové dáta na rozpoznanie smeru, ktorým ste otočení, a na nasmerovanie zvukových hlásení podľa vášho okolia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape uporablja podatke o gibanju, da zazna smer, v katero ste obrnjeni, in zvočna obvestila umesti glede na vašo okolico."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape користи податке о кретању да би открио правац у коме сте окренути и ускладио звучне најаве са вашом околином."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape använder rörelsedata för att känna av vilken riktning du är vänd mot och placera informationsljuden i förhållande till dina omgivningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape hutumia data ya mwendo kutambua upande uliouelekea na kupanga matangazo ya sauti kulingana na mazingira yanayokuzunguka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எந்தத் திசையை நோக்கி உள்ளீர்கள் என்பதைக் கண்டறியவும், அறிவிப்புகளை உங்கள் சுற்றுப்புறத்திற்கு ஏற்ப திசைப்படுத்தவும் Soundscape இயக்கத் தரவைப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఏ దిశ వైపు ముఖం పెట్టి ఉన్నారో గుర్తించడానికి మరియు కాలౌట్‌లను మీ పరిసరాలకు అనుగుణంగా ఉంచడానికి Soundscape మోషన్ డేటాను ఉపయోగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape ใช้ข้อมูลการเคลื่อนไหวเพื่อตรวจจับทิศทางที่คุณหันหน้าไป และจัดวางการแจ้งเตือนด้วยเสียงให้สอดคล้องกับสภาพแวดล้อมรอบตัวคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape, baktığınız yönü algılamak ve sesli anonsları çevrenize göre yönlendirmek için hareket verilerini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape використовує дані руху, щоб визначати напрямок, у який ви повернені, і спрямовувати звукові оголошення відповідно до вашого оточення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape حرکت کے ڈیٹا کا استعمال کرتے ہوئے آپ کے رخ کی سمت معلوم کرتا ہے اور آڈیو کالآؤٹس کو آپ کے ارد گرد کے ماحول کے مطابق ترتیب دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape sử dụng dữ liệu chuyển động để xác định hướng bạn đang quay mặt và định hướng các thông báo âm thanh theo không gian xung quanh bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape 使用运动数据来检测您面朝的方向，并将语音提示的方位与您周围的环境对应起来。"
          }
        }
      }
    }
  },
  "version": "1.0"
