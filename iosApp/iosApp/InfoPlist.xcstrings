{
  "sourceLanguage": "en",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Soundscape البلوتوث لاكتشاف سماعات الرأس المزوّدة بتتبع حركة الرأس والأجهزة الصوتية الأخرى والاتصال بها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape използва Bluetooth, за да открива слушалки с проследяване на главата и други аудио устройства и да се свързва с тях."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হেড ট্র্যাকিং সমর্থিত হেডফোন এবং অন্যান্য অডিও ডিভাইস খুঁজে পেতে ও সেগুলোর সাথে সংযোগ করতে Soundscape ব্লুটুথ ব্যবহার করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape utilitza el Bluetooth per detectar auriculars amb seguiment del cap i altres dispositius d'àudio, i connectar-s'hi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape používá Bluetooth k vyhledání sluchátek se sledováním polohy hlavy a dalších zvukových zařízení a k připojení k nim."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape bruger Bluetooth til at finde og oprette forbindelse til hovedtelefoner med hovedsporing og andre lydenheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape verwendet Bluetooth, um Kopfhörer mit Head-Tracking und andere Audiogeräte zu finden und sich mit ihnen zu verbinden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Soundscape χρησιμοποιεί Bluetooth για να εντοπίζει ακουστικά με παρακολούθηση κεφαλής και άλλες συσκευές ήχου και να συνδέεται σε αυτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape uses Bluetooth to discover and connect to head-tracking headphones and other audio devices."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape uses Bluetooth to discover and connect to head-tracking headphones and other audio devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape usa Bluetooth para detectar auriculares con seguimiento de la cabeza y otros dispositivos de audio, y conectarse a ellos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape kasutab Bluetoothi, et leida pea jälgimisega kõrvaklappe ja muid heliseadmeid ning nendega ühenduda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساند‌اسکیپ از بلوتوث برای یافتن هدفون‌های دارای ردیابی سر و دیگر دستگاه‌های صوتی و اتصال به آنها استفاده می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape käyttää Bluetoothia löytääkseen pään seurantaa tukevat kuulokkeet ja muut äänilaitteet ja muodostaakseen niihin yhteyden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape utilise le Bluetooth pour détecter les casques avec suivi de la tête et les autres appareils audio, et s’y connecter."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape utilise le Bluetooth pour détecter les casques avec suivi de la tête et les autres appareils audio, et s’y connecter."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape tana amfani da Bluetooth domin gano belun kunne masu bin diddigin kai da sauran na'urorin sauti sannan ta haɗa da su."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape हेड ट्रैकिंग वाले हेडफ़ोन और अन्य ऑडियो डिवाइस खोजने और उनसे कनेक्ट करने के लिए ब्लूटूथ का उपयोग करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape koristi Bluetooth za pronalaženje slušalica s praćenjem pokreta glave i drugih zvučnih uređaja te povezivanje s njima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Soundscape Bluetooth-t használ a fejkövetést támogató fejhallgatók és egyéb hangeszközök megkereséséhez és a hozzájuk való csatlakozáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape menggunakan Bluetooth untuk menemukan dan terhubung ke headphone dengan pelacakan kepala serta perangkat audio lainnya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape notar Bluetooth til að finna heyrnartól með höfuðrakningu og önnur hljóðtæki og tengjast þeim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape utilizza il Bluetooth per rilevare auricolari con tracciamento della testa e altri dispositivi audio e connettersi a essi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape は、ヘッドトラッキング対応ヘッドホンやその他のオーディオ機器を検出して接続するために Bluetooth を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape는 블루투스를 사용하여 헤드 트래킹 헤드폰 및 기타 오디오 기기를 검색하고 연결합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हेड ट्रॅकिंग असलेले हेडफोन आणि इतर ऑडिओ उपकरणे शोधण्यासाठी व त्यांच्याशी जोडण्यासाठी Soundscape ब्लूटूथ वापरते."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape bruker Bluetooth for å finne og koble til hodetelefoner med hodesporing og andre lydenheter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape gebruikt Bluetooth om koptelefoons met hoofdtracking en andere audioapparaten te vinden en er verbinding mee te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape używa Bluetooth, aby wykrywać słuchawki ze śledzeniem ruchu głowy oraz inne urządzenia audio i łączyć się z nimi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Soundscape utiliza o Bluetooth para detetar auscultadores com rastreio da cabeça e outros dispositivos de áudio, e ligar-se a eles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Soundscape usa Bluetooth para descobrir fones de ouvido com rastreamento de cabeça e outros dispositivos de áudio e conectar-se a eles."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape folosește Bluetooth pentru a detecta căștile cu urmărirea capului și alte dispozitive audio și pentru a se conecta la ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape использует Bluetooth, чтобы находить наушники с отслеживанием головы и другие аудиоустройства и подключаться к ним."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape používa Bluetooth na vyhľadanie slúchadiel so sledovaním polohy hlavy a ďalších zvukových zariadení a na pripojenie k nim."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape uporablja Bluetooth za iskanje slušalk s sledenjem glavi in drugih zvočnih naprav ter za povezovanje z njimi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape користи Bluetooth за проналажење слушалица са праћењем покрета главе и других звучних уређаја и повезивање са њима."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape använder Bluetooth för att hitta och ansluta till hörlurar med huvudspårning och andra ljudenheter."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape hutumia Bluetooth kutafuta na kuunganisha vipokea sauti vyenye ufuatiliaji wa kichwa na vifaa vingine vya sauti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலை கண்காணிப்பு கொண்ட ஹெட்போன்கள் மற்றும் பிற ஆடியோ சாதனங்களைக் கண்டறிந்து இணைக்க Soundscape Bluetooth ஐப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హెడ్ ట్రాకింగ్ ఉన్న హెడ్‌ఫోన్‌లను మరియు ఇతర ఆడియో పరికరాలను కనుగొని వాటికి కనెక్ట్ కావడానికి Soundscape బ్లూటూత్‌ను ఉపయోగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape ใช้บลูทูธเพื่อค้นหาและเชื่อมต่อกับหูฟังที่รองรับการติดตามการเคลื่อนไหวศีรษะและอุปกรณ์เสียงอื่นๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape, baş takibi olan kulaklıkları ve diğer ses cihazlarını bulup bunlara bağlanmak için Bluetooth kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape використовує Bluetooth, щоб знаходити навушники з відстеженням голови та інші аудіопристрої й підключатися до них."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape ہیڈ ٹریکنگ والے ہیڈفونز اور دیگر آڈیو آلات کو دریافت کرنے اور ان سے منسلک ہونے کے لیے بلوٹوتھ استعمال کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape sử dụng Bluetooth để tìm và kết nối với tai nghe có theo dõi chuyển động đầu và các thiết bị âm thanh khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape 使用蓝牙来发现并连接支持头部追踪的耳机及其他音频设备。"
          }
        }
      }
    },
