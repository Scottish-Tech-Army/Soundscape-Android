    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape needs your location to provide audio navigation even when the app is in the background."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape needs your location to provide audio navigation and describe your surroundings."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soundscape uses motion data to detect the direction you are facing and orient audio callouts to your surroundings."
          }
        }
      }
    }
