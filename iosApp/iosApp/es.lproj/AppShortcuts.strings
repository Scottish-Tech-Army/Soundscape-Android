/* Spoken Siri commands - Spanish.

   Values only: the keys are the English phrases declared in
   SoundscapeAppShortcuts.swift and must stay exactly as they are. See
   en.lproj/AppShortcuts.strings for the rules (${applicationName} in every phrase, ${parameter}
   tokens kept but free to move).

   Every phrase keeps the shape "<app name> <group> <choice>", so knowing the six
   group words is enough to reach everything.

   First pass, not authored by a native speaker - corrections welcome. */

"${applicationName} surroundings ${kind}" = "${applicationName} entorno ${kind}";
"${applicationName} surroundings" = "${applicationName} entorno";

"${applicationName} route ${command}" = "${applicationName} ruta ${command}";
"${applicationName} route" = "${applicationName} ruta";

"${applicationName} start route ${route}" = "${applicationName} iniciar ruta ${route}";
"${applicationName} start route" = "${applicationName} iniciar ruta";

"${applicationName} beacon ${marker}" = "${applicationName} señal ${marker}";
"${applicationName} beacon" = "${applicationName} señal";

"${applicationName} list ${kind}" = "${applicationName} lista ${kind}";
"${applicationName} list" = "${applicationName} lista";

"${applicationName} stop beacon" = "${applicationName} detener señal";
