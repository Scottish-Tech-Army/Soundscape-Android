# Copy to farm.toml and edit. Every setting is optional; these are the defaults
# except where noted. Paths are relative to this file.

# Where release builds come from: the newest two successful runs of this
# workflow, using the APK that goes to Play.
release_repo = "Scottish-Tech-Army/Soundscape-Android"
release_workflow = "build-app.yaml"
release_artifact = "release-apk"
poll_minutes = 15

monkey_events = 5000          # several minutes; not every event waits the throttle
monkey_throttle_ms = 250
roam_rounds = 2               # rounds of flows/roam/ (shuffled) per cycle
flow_timeout_minutes = 15
keep_days = 14                # per-cycle logs/screenshots under runs/

# Run one Maestro flow at a time across all phones, if parallel runs collide.
serialize_maestro = false

# If a phone has a Soundscape the farm didn't install (Play Store, debug build),
# uninstall it, wiping its data. Off by default: the phone is reported as blocked.
allow_reinstall = false

# Test a locally built APK instead of the CI releases, on every phone or (in a
# [devices] entry) on one. It's usually signed with a different key, so whatever
# is on the phone is uninstalled, wiping its data, and the app is set up afresh.
# Unset it to go back to the releases, which replace the local build the same way.
# local_apk = "/path/to/app-release.apk"

# When Restore fails after the monkey soak even with the app brought back to
# the front, leave the phone as it is for up to pause_minutes before restarting
# the app, so it can be looked at. Create a file named
# resume-<serial> next to farm.py to carry on sooner.
pause_on_restore_failure = false
pause_minutes = 30

include_emulators = false
include_ios = true            # observe USB iPhones via pymobiledevice3 (see README)
ios_poll_minutes = 10
max_battery_temp_c = 42       # pause the phone for 10 minutes above this
battery_poll_minutes = 1      # battery level and temperature readings (vitals table, report)

# Mock location: follow this GPX track, turning round at each end. The default
# is the synthetic walk/bus/train track, replayed by its timestamps (see the
# README). Any other track, such as a real recording, is walked at
# replay_speed_mps. With default_gpx = "", hold default_location (lat, lon).
replay_speed_mps = 1.4
default_location = [55.9474, -4.3058]
default_gpx = "tracks/glasgow-multimodal.gpx"
# Held while the Maestro suite runs; the flows assert distance order.
suite_location = [55.955360, -3.223538]

# Offline map pushed to every phone, by manifest name; must cover
# suite_location and the GPX track. URL defaults to local.properties'
# extractProviderUrl.
extract_name = "Glasgow"
# extract_provider_url = ""

# false cuts apps off from the motion sensors, so Soundscape has no compass
# and never sees a phone lying flat on the desk; it takes its heading from
# travel, as in a pocket. Lifted when the farm stops. Default true.
# sensors = false

# Per-phone overrides, keyed by `adb devices` serial.
# [devices."R5CW12345AB"]
# gpx = "../local-cubot.gpx"
# skip = true
# show_map = false   # keep the map off (low-memory phones); default true
# sensors = true     # override the global sensors setting for this phone
