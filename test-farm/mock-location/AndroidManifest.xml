<?xml version="1.0" encoding="utf-8"?>
<!-- Test-farm mock location provider. Not part of Soundscape: the farm installs
     it next to the release build so that mock fixes can carry speed and bearing,
     which `cmd location providers set-test-provider-location` can't set. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.scottishtecharmy.farmlocation">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application android:label="Soundscape farm location" android:hasCode="true">
        <!-- Keeps the process alive between fixes (see KeepAlive.java). -->
        <service
            android:name=".KeepAlive"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds a test-only mock location provider between fixes" />
        </service>
        <!-- How the farm sends fixes (see FixProvider.java); it checks for DUMP itself. -->
        <provider
            android:name=".FixProvider"
            android:authorities="org.scottishtecharmy.farmlocation"
            android:exported="true" />
        <!-- android.permission.DUMP is held by adb's shell, not by ordinary apps,
             so only the farm can feed this phone fake locations. -->
        <receiver
            android:name=".FixReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
